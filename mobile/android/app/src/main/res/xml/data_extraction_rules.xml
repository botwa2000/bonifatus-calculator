<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Data Extraction Rules (API 31+, Android 12+).
  Covers both cloud backup and device-to-device transfer.
  flutter_secure_storage files are excluded — they contain JWTs and
  biometric snapshots that must not transfer to another device unverified.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
        <exclude domain="file" path="flutter_secure_storage"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
        <exclude domain="file" path="flutter_secure_storage"/>
    </device-transfer>
</data-extraction-rules>
